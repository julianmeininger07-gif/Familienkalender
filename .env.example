# --- Für den Betrieb mit Docker (docker-compose.yml liest diese Datei) ---
# Eigene Domain, die auf den Server zeigt. Caddy holt dafür automatisch ein HTTPS-Zertifikat.
DOMAIN=kalender.example.de
# Öffentliche Adresse der App (für Einladungslinks). Mit Domain: https://<DOMAIN>
APP_URL=https://kalender.example.de
# Datenbank-Passwort: einmal festlegen und danach nicht mehr ändern
DB_PASSWORD=bitte-aendern
# Kontakt für die Push-Dienste von Apple/Google (optional, sonst wird APP_URL genommen)
VAPID_SUBJECT=mailto:du@example.de

# --- Nur für die Entwicklung ohne Docker ---
DATABASE_URL=postgres://kalender:kalender@localhost:5432/kalender
